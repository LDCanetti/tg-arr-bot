# Telegram Bot Token
TELEGRAM_TOKEN= bot_token_here

# Sonarr Configuration
SONARR_API_KEY=your_sonarr_api_key_here

# Radarr Configuration
RADARR_API_KEY=your_radarr_api_key_here

# Security - Comma-separated list of allowed Telegram user IDs
ALLOWED_USERS=telegram_uid_here

# Security - Comma-separated group chat IDs (negative, e.g. -1001234567890) whose
# members may ALL use the bot. Anyone added to such a group gets library write
# access, so only list groups you control. Leave empty for user-only access.
# Note: inline queries carry no chat, so they stay restricted to ALLOWED_USERS.
ALLOWED_CHATS=

# Optional - Quality profile used for everything the bot adds. 1 is "Any"
# (grab any quality, upgrade toward the profile cutoff). Must exist in Sonarr/Radarr.
QUALITY_PROFILE_ID=1

# Optional - Root folder paths for adds. Must match a registered root folder
# in Sonarr/Radarr. Defaults shown; override only if your library paths differ.
SONARR_ROOT_SHOWS=/data/Plex/Shows
SONARR_ROOT_ANIME=/data/Plex/Anime
RADARR_ROOT_MOVIES=/data/Plex/Movies

# Optional - After an update with new release notes, privately send them to
# ALLOWED_USERS once. Set to false to keep quiet.
UPDATE_NOTICES=true
